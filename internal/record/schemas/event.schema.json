{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eventlog.gunesis-game.dev/schemas/v1/event.schema.json",
  "title": "Eventlog v1 Event record",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "kind": { "const": "event" },
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "channel_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "type": { "$ref": "event-type.schema.json" },
    "fields": { "type": "object", "propertyNames": { "minLength": 1 }, "additionalProperties": { "$ref": "field-value.schema.json" } },
    "device_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "vector": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
    },
    "hlc": {
      "type": "object",
      "properties": {
        "wall_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "logical": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "required": ["wall_ms", "logical"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "sequence", "kind", "id", "channel_id", "type", "fields", "device_id", "vector", "hlc"],
  "additionalProperties": false
}