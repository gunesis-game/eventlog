{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gunesis-game/project-steering-template/blob/main/docs/dev-life-cycle/cycle-index.schema.json",
  "title": "Development Cycle Registry",
  "description": "Structural schema for the authoritative persisted development-cycle ledger. Cross-record invariants are specified in README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cycles"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "cycles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cycle"
      }
    }
  },
  "$defs": {
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "execution_order",
        "workflow",
        "description",
        "status",
        "created_at",
        "started_at",
        "completed_at",
        "current_phase",
        "eligibility_reason",
        "acceptance_criteria",
        "verification_evidence",
        "outcome",
        "status_reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "execution_order": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "workflow": {
          "enum": [
            "standard",
            "micro"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "in-progress",
            "paused",
            "blocked",
            "cancelled",
            "complete"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "started_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "current_phase": {
          "enum": [
            "assess",
            "define",
            "implement",
            "verify",
            "reconcile",
            "complete"
          ]
        },
        "eligibility_reason": {
          "$ref": "#/$defs/nullableText"
        },
        "acceptance_criteria": {
          "$ref": "#/$defs/nullableText"
        },
        "verification_evidence": {
          "$ref": "#/$defs/nullableText"
        },
        "outcome": {
          "$ref": "#/$defs/nullableText"
        },
        "status_reason": {
          "$ref": "#/$defs/nullableText"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "workflow": {
                "const": "micro"
              }
            },
            "required": [
              "workflow"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "in-progress",
                  "complete"
                ]
              },
              "current_phase": {
                "enum": [
                  "implement",
                  "complete"
                ]
              },
              "eligibility_reason": {
                "type": "string",
                "minLength": 1
              },
              "acceptance_criteria": {
                "type": "string",
                "minLength": 1
              },
              "execution_order": {
                "type": "integer",
                "minimum": 1
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "in-progress"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "completed_at": {
                      "type": "null"
                    },
                    "verification_evidence": {
                      "type": "null"
                    },
                    "outcome": {
                      "type": "null"
                    },
                    "current_phase": {
                      "const": "implement"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "complete"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "current_phase": {
                      "const": "complete"
                    },
                    "completed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "verification_evidence": {
                      "type": "string",
                      "minLength": 1
                    },
                    "outcome": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "nullableTimestamp": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
